#!/usr/bin/env bash
set -euo pipefail

port=/dev/virtio-ports/org.frr.appliance.selftest

# virtio_console is modular on Debian; do not depend on udev autoloading it.
modprobe virtio_console 2>/dev/null || true
udevadm settle --timeout=10 2>/dev/null || true

for _ in $(seq 1 30); do
  if [[ -w "$port" ]]; then
    printf 'APPLIANCE_BOOT=READY\n' > "$port"
    exit 0
  fi
  sleep 1
done

# The CI port does not exist on normal appliances.
exit 0
