#!/usr/bin/env bash
set -euo pipefail

[[ $(id -u) -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
install -d -m 0755 /run/appliance
exec 9>/run/appliance/firstboot.lock
flock 9
[[ ! -e /var/lib/appliance/firstboot.done ]] || exit 0

echo
echo "FRR Appliance first boot"
echo "------------------------"
hostname=""
while [[ -z "$hostname" ]]; do
  read -r -p "Hostname [router]: " hostname
  hostname=${hostname:-router}
  if [[ ! "$hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$ ]]; then
    echo "Invalid hostname: use letters, digits, dots and dashes (max 63 characters)." >&2
    hostname=""
  fi
done

# Set hostname without depending on D-Bus/systemd-hostnamed during early login.
printf '%s\n' "$hostname" > /etc/hostname
printf '%s' "$hostname" > /proc/sys/kernel/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1 localhost
127.0.1.1 $hostname
::1 localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
HOSTS

# Keep FRR's hostname aligned. Prefer the native CLI if FRR is ready.
if timeout 5 vtysh -c 'show version' >/dev/null 2>&1; then
  timeout 10 vtysh \
    -c 'configure terminal' \
    -c "hostname $hostname" \
    -c 'end' \
    -c 'write memory' || true
else
  if grep -q '^hostname ' /etc/frr/frr.conf; then
    sed -i "s/^hostname .*/hostname $hostname/" /etc/frr/frr.conf
  else
    sed -i "/^frr defaults/a hostname $hostname" /etc/frr/frr.conf
  fi
fi
if grep -q '^hostname ' /etc/frr/vtysh.conf; then
  sed -i "s/^hostname .*/hostname $hostname/" /etc/frr/vtysh.conf
else
  printf 'hostname %s\n' "$hostname" >> /etc/frr/vtysh.conf
fi

echo
echo "Set the admin password."
echo "Policy: at least 12 characters, at least 3 of upper/lower/digit/symbol,"
echo "at most 3 identical characters in a row, and not a dictionary word."
password_set=0
for _ in $(seq 1 5); do
  if passwd admin; then
    password_set=1
    break
  fi
done
# Never loop forever here: if the policy cannot be satisfied at all the console
# would be unusable, and the operator needs to see why.
if [[ $password_set -ne 1 ]]; then
  echo >&2
  echo 'Could not set the admin password, so first boot is not complete.' >&2
  echo 'Log in again and rerun: sudo appliance-firstboot' >&2
  exit 1
fi

install -d -m 0755 /var/lib/appliance
touch /var/lib/appliance/firstboot.done
chown root:root /var/lib/appliance/firstboot.done
chmod 0600 /var/lib/appliance/firstboot.done

# Drop-ins are gone on the next getty start/reboot; no systemd bus is required here.
rm -f /etc/systemd/system/getty@tty1.service.d/10-appliance-firstboot.conf
rm -f /etc/systemd/system/serial-getty@ttyS0.service.d/10-appliance-firstboot.conf

echo
echo "Bootstrap complete. Configure interfaces and routing in FRR, then 'write memory'."
