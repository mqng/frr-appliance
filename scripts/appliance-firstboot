#!/usr/bin/env bash
set -euo pipefail

[[ $(id -u) -eq 0 ]] || { echo "must run as root" >&2; exit 1; }
[[ ! -e /var/lib/appliance/firstboot.done ]] || exit 0

echo
echo "FRR appliance setup"
echo
hostname=""
while [[ -z "$hostname" ]]; do
  read -r -p "Hostname [router]: " hostname
  hostname=${hostname:-router}
  if [[ ! "$hostname" =~ ^[A-Za-z0-9][A-Za-z0-9.-]{0,62}$ ]]; then
    echo "Letters, digits, dots and dashes only, up to 63 characters." >&2
    hostname=""
  fi
done

printf '%s\n' "$hostname" > /etc/hostname
printf '%s' "$hostname" > /proc/sys/kernel/hostname
cat > /etc/hosts <<HOSTS
127.0.0.1 localhost
127.0.1.1 $hostname
::1 localhost ip6-localhost ip6-loopback
ff02::1 ip6-allnodes
ff02::2 ip6-allrouters
HOSTS

if timeout 5 vtysh -c 'show version' >/dev/null 2>&1; then
  timeout 10 vtysh \
    -c 'configure terminal' \
    -c "hostname $hostname" \
    -c 'end' \
    -c 'write memory' || true
else
  if grep -q '^hostname ' /etc/frr/frr.conf; then
    sed -i "s/^hostname .*/hostname $hostname/" /etc/frr/frr.conf
  else
    sed -i "/^frr defaults/a hostname $hostname" /etc/frr/frr.conf
  fi
fi
if grep -q '^hostname ' /etc/frr/vtysh.conf; then
  sed -i "s/^hostname .*/hostname $hostname/" /etc/frr/vtysh.conf
else
  printf 'hostname %s\n' "$hostname" >> /etc/frr/vtysh.conf
fi

echo
echo "Admin password: 12 characters or more, 3 of upper/lower/digit/symbol."
password_set=0
for _ in $(seq 1 5); do
  if passwd admin; then
    password_set=1
    break
  fi
done
if [[ $password_set -ne 1 ]]; then
  echo >&2
  echo "Password not set, setup incomplete. Run 'sudo appliance-firstboot' to retry." >&2
  exit 1
fi

echo
echo "Security updates can install automatically. If not, you get a notice at"
echo "login when there are updates waiting."
auto_upgrade=n
read -r -p "Install security updates automatically? [y/N]: " auto_upgrade || true
autoconf=/etc/apt/apt.conf.d/21appliance-auto-upgrades
if [[ "$auto_upgrade" =~ ^[Yy] ]]; then
  printf 'APT::Periodic::Unattended-Upgrade "1";\n' > "$autoconf"
  chmod 0644 "$autoconf"
else
  rm -f "$autoconf"
fi

install -d -m 0755 /var/lib/appliance
touch /var/lib/appliance/firstboot.done
chown root:root /var/lib/appliance/firstboot.done
chmod 0600 /var/lib/appliance/firstboot.done

echo
echo "Setup complete. Configure interfaces and routing in vtysh, then 'write memory'."
