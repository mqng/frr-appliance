#!/usr/bin/env bash
set -euo pipefail
install -d -m 0755 /var/lib/appliance
src=$(findmnt -n -o SOURCE /)
[[ "$src" == /dev/* ]] || { touch /var/lib/appliance/root-grown; exit 0; }
parent=$(lsblk -no PKNAME "$src" | head -1)
partnum=$(lsblk -no PARTN "$src" | head -1)
[[ -n "$parent" && -n "$partnum" ]] || { touch /var/lib/appliance/root-grown; exit 0; }
growpart "/dev/$parent" "$partnum" || true
fstype=$(findmnt -n -o FSTYPE /)
case "$fstype" in
  ext4|ext3|ext2) resize2fs "$src" || true ;;
  xfs) xfs_growfs / || true ;;
esac
touch /var/lib/appliance/root-grown
