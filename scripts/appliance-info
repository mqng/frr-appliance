#!/usr/bin/env bash
set -euo pipefail

# shellcheck source=/dev/null
. /etc/appliance/build.env

printf 'variant  %s\n' "$APPLIANCE_VARIANT"
printf 'built    %s\n' "$APPLIANCE_BUILD_TIME"
printf 'debian   %s (%s)\n' "$DEBIAN_VERSION" "$DEBIAN_CODENAME"
printf 'kernel   %s\n' "$(uname -r)"
printf 'frr      %s\n' "$FRR_VERSION"
[[ "$VPP_VERSION" == none ]] || printf 'vpp      %s\n' "$VPP_VERSION"
