#!/usr/bin/env bash
set -euo pipefail

[[ $(id -u) -eq 0 ]] || { echo 'run as root' >&2; exit 1; }

src=${1:-/dev/stdin}

stage=$(mktemp -d)
saved=$(mktemp -d)
archive=$(mktemp)
trap 'rm -rf "$stage" "$saved"; rm -f "$archive"' EXIT

cat "$src" > "$archive"

wanted=()
while IFS= read -r member; do
  case "$member" in
    *..*|*/) echo "skipping $member" >&2 ;;
    appliance-backup) wanted+=("$member") ;;
    etc/hostname|etc/hosts|etc/resolv.conf) wanted+=("$member") ;;
    etc/apt/apt.conf.d/21appliance-auto-upgrades) wanted+=("$member") ;;
    etc/frr/*[!/]|etc/nftables.d/*[!/]) wanted+=("$member") ;;
    etc/chrony/*[!/]|etc/snmp/*[!/]|etc/appliance/*[!/]) wanted+=("$member") ;;
    *) echo "skipping $member" >&2 ;;
  esac
done < <(tar --list --gzip --file "$archive")

[[ ${#wanted[@]} -gt 0 ]] || { echo 'nothing to restore' >&2; exit 1; }

tar --extract --gzip --file "$archive" --directory "$stage" \
  --no-same-owner --no-same-permissions -- "${wanted[@]}"
[[ -f "$stage/appliance-backup" ]] || { echo 'not an appliance backup' >&2; exit 1; }

# shellcheck source=/dev/null
. /etc/appliance/build.env
from=$(awk -F= '/^variant=/ { print $2 }' "$stage/appliance-backup")
[[ "$from" == "$APPLIANCE_VARIANT" ]] ||
  echo "note: backup came from the $from variant" >&2

[[ -d /etc/nftables.d ]] && cp -a /etc/nftables.d "$saved/"

restored=0
while IFS= read -r -d '' rel; do
  [[ "$rel" == appliance-backup ]] && continue
  install -D -m 0644 "$stage/$rel" "/$rel"
  restored=$((restored + 1))
done < <(cd "$stage" && find . -type f -printf '%P\0')

chown frr:frr /etc/frr/frr.conf /etc/frr/daemons 2>/dev/null || true
chmod 0640 /etc/frr/frr.conf /etc/frr/daemons 2>/dev/null || true
chown root:frrvty /etc/frr/vtysh.conf 2>/dev/null || true
chmod 0640 /etc/frr/vtysh.conf 2>/dev/null || true
chmod 0600 /etc/snmp/snmpd.conf 2>/dev/null || true

if ! nft --check --file /etc/nftables.conf; then
  rm -f /etc/nftables.d/*.nft
  [[ -d "$saved/nftables.d" ]] && cp -a "$saved/nftables.d/." /etc/nftables.d/
  echo 'restored firewall rules do not load, kept the previous ones' >&2
  exit 1
fi

printf '%s' "$(cat /etc/hostname)" > /proc/sys/kernel/hostname
systemctl reload nftables || systemctl restart nftables
systemctl reload frr || systemctl restart frr
systemctl try-restart chrony || true

echo "restored $restored file(s). Check 'show running-config' in vtysh."
