#!/usr/bin/env bash
set -uo pipefail

variant=${1:?}
port=/dev/virtio-ports/org.frr.appliance.selftest

# The port exists only in CI. Production boots exit immediately.
for _ in $(seq 1 5); do
  [[ -w "$port" ]] && break
  modprobe virtio_console >/dev/null 2>&1 || true
  sleep 1
done
[[ -w "$port" ]] || exit 0
exec 3>"$port"

emit() { printf '%s\n' "$*" >&3; }
fail() { emit "APPLIANCE_SELFTEST=FAIL variant=$variant check=$1"; exit 1; }

emit "APPLIANCE_BOOT=READY variant=$variant"

# Do not block systemd on FRR ordering; poll it with a hard deadline instead.
frr_ready=0
for _ in $(seq 1 180); do
  if systemctl is-active --quiet frr; then
    frr_ready=1
    break
  fi
  sleep 1
done
[[ $frr_ready -eq 1 ]] || fail frr-service

timeout 15 vtysh -c 'show version' >/dev/null 2>&1 || fail frr-vtysh
timeout 15 vtysh -c 'show interface' >/dev/null 2>&1 || fail frr-interface
sshd -t >/dev/null 2>&1 || fail sshd
nft --check --file /etc/nftables.conf >/dev/null 2>&1 || fail nftables

if [[ "$variant" == vpp ]]; then
  vpp_ready=0
  for _ in $(seq 1 120); do
    if systemctl is-active --quiet vpp; then
      vpp_ready=1
      break
    fi
    sleep 1
  done
  [[ $vpp_ready -eq 1 ]] || fail vpp-service
  timeout 15 vppctl show version >/dev/null 2>&1 || fail vpp-cli
fi

emit "APPLIANCE_SELFTEST=PASS variant=$variant"
