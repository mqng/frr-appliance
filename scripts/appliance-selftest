#!/usr/bin/env bash
set -uo pipefail

# shellcheck source=/dev/null
. /etc/appliance/build.env
variant=${APPLIANCE_VARIANT:?}
port=/dev/virtio-ports/org.frr.appliance.selftest

for _ in $(seq 1 5); do
  [[ -w "$port" ]] && break
  modprobe virtio_console >/dev/null 2>&1 || true
  sleep 1
done
[[ -w "$port" ]] || exit 0
exec 3>"$port"

emit() { printf '%s\n' "$*" >&3; }
fail() { emit "APPLIANCE_SELFTEST=FAIL variant=$variant check=$1"; exit 1; }

detail() {
  local check=$1 text=${2//$'\n'/ | }
  emit "APPLIANCE_SELFTEST_DETAIL variant=$variant check=$check: ${text:0:1200}"
}

await() {
  local check=$1 budget=$2
  shift 2
  local output='' deadline
  deadline=$(( $(date +%s) + budget ))
  while :; do
    if output=$(timeout 10 "$@" 2>&1); then
      return 0
    fi
    (( $(date +%s) < deadline )) || break
    sleep 1
  done
  detail "$check" "$output"
  fail "$check"
}

await_active() {
  local check=$1 unit=$2 budget=$3
  shift 3
  local related=("$unit" "$@") states='' u deadline
  deadline=$(( $(date +%s) + budget ))
  while :; do
    if systemctl is-active --quiet "$unit"; then
      return 0
    fi
    (( $(date +%s) < deadline )) || break
    sleep 1
  done
  for u in "${related[@]}"; do
    states+=" $u=[$(systemctl show -p LoadState -p UnitFileState -p FragmentPath \
      -p DropInPaths -p ActiveState -p Result "$u" 2>&1 | tr '\n' ' ')]"
  done
  detail "$check" "${states# }"
  for u in "${related[@]}"; do
    detail "$check-journal-$u" "$(journalctl -b --no-pager -n 12 -u "$u" 2>&1)"
    detail "$check-deps-$u" "$(systemctl show -p WantedBy -p RequiredBy -p Requires \
      -p After "$u" 2>&1 | tr '\n' ' ')"
  done
  detail "$check-transaction" "$(journalctl -b --no-pager 2>&1 |
    grep -iE 'ordering cycle|deleted to break|found dependency|cannot add dependency' |
    tail -n 12)"
  fail "$check"
}

emit "APPLIANCE_BOOT=READY variant=$variant"

await_active frr-service frr 150
await frr-vtysh 45 vtysh -c 'show version'
await frr-interface 30 vtysh -c 'show interface'
await sshd 10 sshd -t
await nftables 10 nft --check --file /etc/nftables.conf
await ping-as-admin 10 runuser -u admin -- ping -c 1 -W 2 127.0.0.1

testnet=198.51.100.0/24
await route-config 15 vtysh -c 'configure terminal' -c "ip route $testnet blackhole" -c 'end'
await route-install 30 sh -c "ip route show $testnet | grep -q blackhole"
await route-remove 15 vtysh -c 'configure terminal' -c "no ip route $testnet blackhole" -c 'end'
if ip route show "$testnet" | grep -q blackhole; then
  detail route-cleanup "$testnet still present after removal"
  fail route-cleanup
fi

if [[ "$variant" == vpp ]]; then
  await_active vpp-service vpp 60 vpp-dpdk-prepare.service vpp-lcp.service
  await vpp-cli 30 vppctl show version
fi

emit "APPLIANCE_SELFTEST=PASS variant=$variant"
