#!/usr/bin/env bash
set -uo pipefail

# ssh commands, scp and sftp arrive here
if [[ ${1:-} == -c ]]; then
  shift
  exec /bin/bash -c "$*"
fi

if [[ ! -e /var/lib/appliance/firstboot.done ]]; then
  sudo /usr/local/sbin/appliance-firstboot || true
fi

if [[ -t 1 ]]; then
  if [[ -s /var/lib/appliance/updates ]]; then
    cat /var/lib/appliance/updates
    echo
  fi
  echo "FRR appliance. Type exit to leave the CLI."
fi
vtysh || true

exec /bin/bash -l
