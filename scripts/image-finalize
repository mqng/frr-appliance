#!/usr/bin/env bash
set -euo pipefail

variant=${1:?usage: image-finalize <vanilla|vpp> <disk> <root-uuid>}
disk=${2:?usage: image-finalize <vanilla|vpp> <disk> <root-uuid>}
root_uuid=${3:?usage: image-finalize <vanilla|vpp> <disk> <root-uuid>}
case "$variant" in vanilla|vpp) ;; *) exit 2 ;; esac
[[ -b "$disk" ]] || { echo "not a block device: $disk" >&2; exit 1; }

ldconfig
found_kernel=0
for modules in /lib/modules/*; do
  [[ -d "$modules" ]] || continue
  kernel=${modules##*/}
  found_kernel=1
  depmod -a "$kernel"
  if [[ -e "/boot/initrd.img-$kernel" ]]; then
    update-initramfs -u -k "$kernel"
  else
    update-initramfs -c -k "$kernel"
  fi
done
[[ $found_kernel -eq 1 ]] || { echo 'no installed kernel modules found' >&2; exit 1; }

services=(
  ssh nftables chrony auditd apparmor frr
  appliance-identity.service appliance-grow-root.service appliance-selftest.service
  appliance-update-check.timer tmp.mount
  getty@tty1.service serial-getty@ttyS0.service
)
if [[ "$variant" == vpp ]]; then
  services+=(vpp vpp-dpdk-prepare.service vpp-lcp.service)
fi
systemctl enable "${services[@]}"

# available, not enabled
systemctl disable snmpd.service >/dev/null 2>&1 || true

# BIOS to the disk, signed UEFI to both paths
grub-install --target=i386-pc --recheck "$disk"
grub-install \
  --target=x86_64-efi \
  --efi-directory=/boot/efi \
  --uefi-secure-boot \
  --no-nvram \
  --removable \
  --recheck
grub-install \
  --target=x86_64-efi \
  --efi-directory=/boot/efi \
  --bootloader-id=debian \
  --uefi-secure-boot \
  --no-nvram \
  --recheck
update-grub

# no loop device names in the image
grep -Eq "root=UUID=${root_uuid}([[:space:]]|$)" /boot/grub/grub.cfg || {
  echo "grub did not use the root filesystem UUID: $root_uuid" >&2
  grep -E '^[[:space:]]*linux[[:space:]]' /boot/grub/grub.cfg >&2 || true
  exit 1
}
if grep -Eq 'root=/dev/loop[0-9]+p?[0-9]*' /boot/grub/grub.cfg; then
  echo 'grub.cfg still refers to a loop device' >&2
  grep -E '^[[:space:]]*linux[[:space:]]' /boot/grub/grub.cfg >&2 || true
  exit 1
fi

test -s /boot/grub/grub.cfg
test -s /boot/efi/EFI/BOOT/BOOTX64.EFI
test -s /boot/efi/EFI/BOOT/grub.cfg
test -s /boot/efi/EFI/debian/grub.cfg
grep -q 'console=ttyS0,115200n8' /boot/grub/grub.cfg
